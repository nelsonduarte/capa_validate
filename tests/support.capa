// tests/support.capa
//
// Render helpers shared by the suites. Each turns a validator outcome
// into one stable string so the tests can assert it against a literal
// expected value (many of them generated by the Python oracle, run
// outside the repo). Rendering, not the assertion, lives here so the
// suites read as `eq_str(..., int_res(parse_int_in_range(...)), "...")`.

import capa_validate.validate

/// A stable tag string for a `ValidationError`, e.g. `"OutOfRange(0,100)"`.
pub fun err_tag(e: ValidationError) -> String
    return match e
        Empty              -> "Empty"
        TooShort(l, m)     -> "TooShort(${l},${m})"
        TooLong(l, m)      -> "TooLong(${l},${m})"
        NotAscii(i)        -> "NotAscii(${i})"
        NotDigits          -> "NotDigits"
        NotAlphanumeric    -> "NotAlphanumeric"
        NotInSet(v)        -> "NotInSet(${v})"
        DisallowedChar(c)  -> "DisallowedChar(${c})"
        NotInteger         -> "NotInteger"
        NotDecimal         -> "NotDecimal"
        OutOfRange(lo, hi) -> "OutOfRange(${lo},${hi})"
        NotEmail(w)        -> "NotEmail(${w})"
        NotUrl(w)          -> "NotUrl(${w})"

/// Render a `Result<Int, ValidationError>` as `"Ok(<n>)"` or the error tag.
pub fun int_res(r: Result<Int, ValidationError>) -> String
    return match r
        Ok(n)  -> "Ok(${n})"
        Err(e) -> err_tag(e)

/// Render a `Result<String, ValidationError>` as `"Ok(<s>)"` or the tag.
pub fun str_res(r: Result<String, ValidationError>) -> String
    return match r
        Ok(s)  -> "Ok(${s})"
        Err(e) -> err_tag(e)
