// tests/test_numeric.capa
//
// Numeric validators. The parse_int_in_range and classification cases
// are matched against expected values generated by the Python oracle
// (run outside the repo): it mirrors the built-in parse_int (decimal,
// optional sign, surrounding ASCII whitespace, range [-2^63, 2^63)) and
// the digit classification, so these assertions hold byte-identically on
// the Python and Wasm backends.
//
// THE i64 PROOF. Capa's Wasm backend TRAPS on i64 overflow while the
// Python backend uses bignums. parse_int_in_range routes every string
// through parse_int, which fails closed to None (rendered NotInteger)
// for any magnitude outside the signed 64-bit range, so an out-of-i64
// numeric string is rejected cleanly and IDENTICALLY on both backends,
// never parsed to a trapping value. The i64-boundary cases below pin
// that: run this suite with `capa test --both` and the two backends
// print the same lines.

import capa_test.testing
import capa_validate.validate
import support

fun main(stdio: Stdio)
    let t = tester()

    // --- int_in_range: inclusive bounds. ---
    t.eq_str(stdio, "iir_in", int_res(int_in_range(5, 0, 10)), "Ok(5)")
    t.eq_str(stdio, "iir_at_lo", int_res(int_in_range(0, 0, 10)), "Ok(0)")
    t.eq_str(stdio, "iir_at_hi", int_res(int_in_range(10, 0, 10)), "Ok(10)")
    t.eq_str(stdio, "iir_below", int_res(int_in_range(-1, 0, 10)), "OutOfRange(0,10)")
    t.eq_str(stdio, "iir_above", int_res(int_in_range(11, 0, 10)), "OutOfRange(0,10)")

    // --- parse_int_in_range: oracle-matched. ---
    t.eq_str(stdio, "pir_ok", int_res(parse_int_in_range("42", 0, 100)), "Ok(42)")
    // parse_int trims surrounding ASCII whitespace and accepts a sign.
    t.eq_str(stdio, "pir_ws", int_res(parse_int_in_range("  42  ", 0, 100)), "Ok(42)")
    t.eq_str(stdio, "pir_plus", int_res(parse_int_in_range("+7", 0, 100)), "Ok(7)")
    t.eq_str(stdio, "pir_neg_ok", int_res(parse_int_in_range("-7", -100, 100)), "Ok(-7)")
    t.eq_str(stdio, "pir_neg_oor", int_res(parse_int_in_range("-7", 0, 100)), "OutOfRange(0,100)")
    t.eq_str(stdio, "pir_at_hi", int_res(parse_int_in_range("100", 0, 100)), "Ok(100)")
    t.eq_str(stdio, "pir_over_hi", int_res(parse_int_in_range("101", 0, 100)), "OutOfRange(0,100)")
    t.eq_str(stdio, "pir_alpha", int_res(parse_int_in_range("abc", 0, 100)), "NotInteger")
    t.eq_str(stdio, "pir_empty", int_res(parse_int_in_range("", 0, 100)), "NotInteger")
    t.eq_str(stdio, "pir_decimal", int_res(parse_int_in_range("3.5", 0, 100)), "NotInteger")
    t.eq_str(stdio, "pir_underscore", int_res(parse_int_in_range("1_000", 0, 100000)), "NotInteger")
    t.eq_str(stdio, "pir_hex", int_res(parse_int_in_range("0x1F", 0, 100000)), "NotInteger")

    // --- i64 BOUNDARY: identical clean rejection on both backends. ---
    // i64 max (2^63 - 1) parses when in range.
    t.eq_str(stdio, "pir_i64_max",
        int_res(parse_int_in_range("9223372036854775807", 0, 9223372036854775807)),
        "Ok(9223372036854775807)")
    // i64 max + 1: out of the signed 64-bit window -> NotInteger, never a trap.
    t.eq_str(stdio, "pir_i64_max_plus1",
        int_res(parse_int_in_range("9223372036854775808", 0, 9223372036854775807)),
        "NotInteger")
    // i64 min (-2^63) parses when in range.
    t.eq_str(stdio, "pir_i64_min",
        int_res(parse_int_in_range("-9223372036854775808", -9223372036854775808, 0)),
        "Ok(-9223372036854775808)")
    // i64 min - 1: out of window -> NotInteger.
    t.eq_str(stdio, "pir_i64_min_minus1",
        int_res(parse_int_in_range("-9223372036854775809", -9223372036854775808, 0)),
        "NotInteger")
    // A magnitude far beyond i64: still a clean NotInteger, no overflow.
    t.eq_str(stdio, "pir_huge",
        int_res(parse_int_in_range("99999999999999999999999999999999", 0, 100)),
        "NotInteger")

    // --- is_integer_string: syntactic, oracle-matched. Note the huge
    // magnitude is syntactically an integer (true) even though
    // parse_int_in_range rejects it: the two answer different questions. ---
    t.eq_bool(stdio, "is_int_plain", is_integer_string("42"), true)
    t.eq_bool(stdio, "is_int_plus", is_integer_string("+42"), true)
    t.eq_bool(stdio, "is_int_neg", is_integer_string("-42"), true)
    t.eq_bool(stdio, "is_int_zero", is_integer_string("0"), true)
    t.eq_bool(stdio, "is_int_leadzero", is_integer_string("007"), true)
    t.eq_bool(stdio, "is_int_empty", is_integer_string(""), false)
    t.eq_bool(stdio, "is_int_sign_only", is_integer_string("+"), false)
    t.eq_bool(stdio, "is_int_lead_ws", is_integer_string(" 42"), false)
    t.eq_bool(stdio, "is_int_trail_ws", is_integer_string("42 "), false)
    t.eq_bool(stdio, "is_int_decimal", is_integer_string("4.2"), false)
    t.eq_bool(stdio, "is_int_alpha", is_integer_string("abc"), false)
    t.eq_bool(stdio, "is_int_huge_syntax", is_integer_string("99999999999999999999999999999999"), true)

    // --- is_decimal_string: syntactic, oracle-matched. Covers the
    // ".5" / "5." edges. ---
    t.eq_bool(stdio, "is_dec_int", is_decimal_string("42"), true)
    t.eq_bool(stdio, "is_dec_frac", is_decimal_string("3.14"), true)
    t.eq_bool(stdio, "is_dec_lead_dot", is_decimal_string(".5"), true)
    t.eq_bool(stdio, "is_dec_trail_dot", is_decimal_string("5."), true)
    t.eq_bool(stdio, "is_dec_neg", is_decimal_string("-0.5"), true)
    t.eq_bool(stdio, "is_dec_plus", is_decimal_string("+3.14"), true)
    t.eq_bool(stdio, "is_dec_zero", is_decimal_string("0.0"), true)
    t.eq_bool(stdio, "is_dec_empty", is_decimal_string(""), false)
    t.eq_bool(stdio, "is_dec_dot_only", is_decimal_string("."), false)
    t.eq_bool(stdio, "is_dec_sign_only", is_decimal_string("+"), false)
    t.eq_bool(stdio, "is_dec_two_dots", is_decimal_string("1.2.3"), false)
    t.eq_bool(stdio, "is_dec_double_dot", is_decimal_string("5..5"), false)
    t.eq_bool(stdio, "is_dec_sci", is_decimal_string("1e3"), false)
    t.eq_bool(stdio, "is_dec_hex", is_decimal_string("0x1F"), false)
    t.eq_bool(stdio, "is_dec_alpha", is_decimal_string("abc"), false)

    t.finish(stdio)
